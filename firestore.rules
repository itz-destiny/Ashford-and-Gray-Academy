rules_version = '2';

// Firestore security rules for the Ashford & Gray Academy realtime layer.
//
// Three collections back the chat + notification UX. They're all written
// exclusively by the Admin SDK from our API routes. Clients are read-only.
//
//   messages/{messageId}        — one doc per chat message
//   conversations/{conversationId} — per-conversation summary doc
//   notifications/{notificationId} — one doc per user notification
//
// Reads are scoped so a user can only read documents they participate in.
// The Admin SDK bypasses these rules entirely (uses service-account auth).
//
// Messages are always queried by conversationId (see
// src/firebase/realtime.ts), never by senderId/receiverId — Firestore can
// only prove a list query safe when the security check is satisfiable from
// data reachable at query time, so the read rule looks up the parent
// conversation's participant list via get() rather than comparing
// resource.data.senderId/receiverId directly (a version of this rule that
// only checked the message's own sender/receiver fields made every list
// query on this collection fail outright with permission-denied, even
// though every individual document actually satisfied it).
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Messages --------
    match /messages/{messageId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      // Writes only from server (Admin SDK bypasses rules).
      allow write: if false;
    }

    // -------- Conversation summaries --------
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    // -------- User notifications --------
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Existing collections used by the older enrollments / registrations
    // bridge stay unaffected. Add specific rules here only if needed.

    // Default-deny everything else. Explicit is safer than implicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
